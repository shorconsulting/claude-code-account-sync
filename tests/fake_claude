#!/usr/bin/env python3
"""Stub of the `claude` CLI for testing account-sync. State lives in <config_dir>/fake_state.json."""
import json, os, sys
from pathlib import Path

home = Path(os.environ["HOME"])
cdir = Path(os.environ["CLAUDE_CONFIG_DIR"]) if os.environ.get("CLAUDE_CONFIG_DIR") else home / ".claude"
gc = cdir / ".claude.json" if os.environ.get("CLAUDE_CONFIG_DIR") else home / ".claude.json"
statef = cdir / "fake_state.json"
cdir.mkdir(parents=True, exist_ok=True)
state = json.loads(statef.read_text()) if statef.exists() else {"marketplaces": {}, "plugins": {}, "connectors": [], "synced": []}
with open(home / "claude_calls.log", "a") as f:
    f.write(f"[{cdir.name}] " + " ".join(sys.argv[1:]) + "\n")
a = sys.argv[1:]

def save():
    statef.write_text(json.dumps(state, indent=1))

if a[:4] == ["plugin", "marketplace", "list", "--json"]:
    print(json.dumps([dict(name=n, **m) for n, m in state["marketplaces"].items()]))
elif a[:3] == ["plugin", "list", "--json"]:
    out = [{"id": pid, "version": "1.0.0", "scope": "user", "enabled": en, "installPath": "/x"} for pid, en in state["plugins"].items()]
    out += [{"id": s, "version": "1", "scope": "synced", "enabled": True, "installPath": "/y"} for s in state["synced"]]
    print(json.dumps(out))
elif a[:3] == ["plugin", "marketplace", "add"]:
    if a[3] == "--claudeai":
        state["marketplaces"][a[4]] = {"source": "claudeai"}
    else:
        src = a[3]
        name = src.split("/")[-1].split("#")[0]
        state["marketplaces"][name] = {"source": "github", "repo": src.split("#")[0]}
    save(); print(f"Successfully added marketplace")
elif a[:2] == ["plugin", "install"]:
    pid = a[2]
    if pid.split("@")[1] not in state["marketplaces"]:
        print(f'Marketplace "{pid.split("@")[1]}" not found', file=sys.stderr); sys.exit(1)
    state["plugins"][pid] = True; save(); print("Successfully installed")
elif a[:2] in (["plugin", "enable"], ["plugin", "disable"]):
    state["plugins"][a[2]] = a[1] == "enable"; save()
elif a[:2] == ["mcp", "list"]:
    g = json.loads(gc.read_text()) if gc.exists() else {}
    for n in (g.get("mcpServers") or {}):
        print(f"{n}: something - ✔ Connected")
    for c in state["connectors"]:
        print(f"{c}: https://example.com/mcp - ✔ Connected")
elif a[:2] == ["mcp", "add-json"]:
    g = json.loads(gc.read_text()) if gc.exists() else {}
    g.setdefault("mcpServers", {})[a[2]] = json.loads(a[3]); gc.write_text(json.dumps(g, indent=2))
    print(f"Added stdio MCP server {a[2]} to user config")
elif a[:2] == ["mcp", "remove"]:
    g = json.loads(gc.read_text()) if gc.exists() else {}
    (g.get("mcpServers") or {}).pop(a[2], None); gc.write_text(json.dumps(g, indent=2))
else:
    print("unknown", a, file=sys.stderr); sys.exit(2)
